// Entry point of the DAX grammar. Only this file (a single-dot .ccc file) is
// picked up as a root grammar by the congocc Maven plugin; the fragment
// files (*.inc.ccc) are pulled in below via INCLUDE and are never processed
// on their own.

PARSER_PACKAGE=org.eclipse.daanse.dax.parser.ccc;
NODE_PACKAGE=org.eclipse.daanse.dax.parser.ccc.tree;
PARSER_CLASS=DaxParser;
LEXER_CLASS=DaxLexer;
DEFAULT_LEXICAL_STATE=DAX;
TAB_SIZE=4;

INCLUDE "Lexer.inc.ccc"
INCLUDE "Expressions.inc.ccc"
INCLUDE "Statements.inc.ccc"
