// DAX Lexer Grammar

SKIP : < WHITESPACE : (" " | "\t" | "\n" | "\r")+ > ;

TOKEN :
   < EVALUATE : "EVALUATE" >
;

// Boolean literals share the BooleanLiteral node class: each token
// occurrence becomes a BooleanLiteral node, distinguished at runtime by its
// own token type (TRUE vs. FALSE).
TOKEN #Literal :
   < TRUE : "true" > #BooleanLiteral
   |
   < FALSE : "false" > #BooleanLiteral
;

TOKEN #Delimiter :
   < LBRACE : "{" >
   |
   < RBRACE : "}" >
   |
   < LPAREN : "(" >
   |
   < RPAREN : ")" >
   |
   < COMMA : "," >
;

// Comparison operators for BooleanExpression. All six alternatives share
// the ComparisonOperator node class (no per-alternative #override), so
// BooleanExpression can find the matched operator token via
// firstChildOfType(ComparisonOperator.class) and tell which one it was via
// getType(). Longer operators (<=, >=, <>) are matched over their shorter
// prefixes (<, >) by the lexer's usual maximal-munch rule, so declaration
// order here does not matter.
TOKEN #ComparisonOperator :
   < LESS_THAN_OR_EQUAL : "<=" >
   |
   < GREATER_THAN_OR_EQUAL : ">=" >
   |
   < NOT_EQUAL : "<>" >
   |
   < LESS_THAN : "<" >
   |
   < GREATER_THAN : ">" >
   |
   < EQUAL : "=" >
;

// Arithmetic operators for ArithmeticExpression. Named ArithmeticOperatorToken
// (not ArithmeticOperator) to avoid colliding with the model.api enum of the
// same simple name, org.eclipse.daanse.dax.model.api.expression
// .ArithmeticExpression.ArithmeticOperator, which ArithmeticExpression's
// INJECT block below also needs in scope.
TOKEN #ArithmeticOperatorToken :
   < PLUS : "+" >
   |
   < MINUS : "-" >
   |
   < ASTERISK : "*" >
   |
   < SLASH : "/" >
   |
   < CARET : "^" >
;

// Logical operators for LogicalExpression. DAX spells AND/OR as && and ||,
// not the keywords. Named LogicalOperatorToken (not LogicalOperator) for the
// same reason as ArithmeticOperatorToken above: it must not collide with the
// model.api enum of the same simple name that LogicalExpression's INJECT
// block below also needs in scope.
TOKEN #LogicalOperatorToken :
   < AND : "&&" >
   |
   < OR : "||" >
;

// The string operator for StringExpression. DAX has a single string
// operator, & (concatenation). Named StringOperatorToken (not
// StringOperator) for the same reason as ArithmeticOperatorToken/
// LogicalOperatorToken above: it must not collide with the model.api enum
// of the same simple name that StringExpression's INJECT block below also
// needs in scope.
TOKEN #StringOperatorToken :
   < AMPERSAND : "&" >
;

// A DAX string literal: double-quoted, where an embedded double quote is
// escaped by doubling it, e.g. "He said ""hi""".
TOKEN :
   < #DOUBLED_QUOTE : "\"\"" >
   |
   < STRING_LITERAL : "\"" ( <DOUBLED_QUOTE> | ~["\""] )* "\"" > #StringLiteral
;

// A DAX date/time literal, e.g. dt"2024-01-31T10:30:00" or the date-only
// dt"2024-01-31". No embedded-quote escaping: date/time values never
// contain a double quote.
TOKEN :
   < DATE_TIME_LITERAL : "dt" "\"" (~["\""])* "\"" > #DateTimeLiteral
;

// A DAX numeric literal, e.g. 42 or 3.14. No leading sign and no exponent
// notation yet; those belong to unary/binary expression grammar once it
// exists.
TOKEN :
   < #DIGIT : ["0"-"9"] >
   |
   < NUMERIC_LITERAL : (<DIGIT>)+ ("." (<DIGIT>)+)? > #NumericLiteral
;

INJECT PARSER_CLASS :
{
   /**
    * Strips the surrounding double quotes from a DAX
    * {@link #STRING_LITERAL} token image and un-doubles embedded
    * {@code ""} escapes back into a single {@code "}.
    */
   public static String stripQuotes(String image) {
      String inner = image.substring(1, image.length() - 1);
      return inner.replace("\"\"", "\"");
   }

   /**
    * Parses a {@link #DATE_TIME_LITERAL} token image (the {@code dt"..."}
    * form) into a {@link java.time.LocalDateTime}, defaulting to midnight
    * when only a date is given.
    */
   public static java.time.LocalDateTime parseDateTimeLiteral(String image) {
      String inner = image.substring(3, image.length() - 1);
      if (inner.indexOf('T') >= 0) {
         return java.time.LocalDateTime.parse(inner);
      }
      return java.time.LocalDate.parse(inner).atStartOfDay();
   }
}

INJECT StringLiteral :
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.stripQuotes;
   implements org.eclipse.daanse.dax.model.api.expression.StringLiteral
{
   private String value;

   public String value() {
      if (value == null) {
         value = stripQuotes(getImage());
      }
      return value;
   }
}

INJECT BooleanLiteral :
   implements org.eclipse.daanse.dax.model.api.expression.BooleanLiteral
{
   public boolean value() {
      return getType() == TokenType.TRUE;
   }
}

INJECT NumericLiteral :
   import java.math.BigDecimal;
   implements org.eclipse.daanse.dax.model.api.expression.NumericLiteral
{
   private BigDecimal value;

   public BigDecimal value() {
      if (value == null) {
         value = new BigDecimal(getImage());
      }
      return value;
   }
}

INJECT DateTimeLiteral :
   import java.time.LocalDateTime;
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.parseDateTimeLiteral;
   implements org.eclipse.daanse.dax.model.api.expression.DateTimeLiteral
{
   private LocalDateTime value;

   public LocalDateTime value() {
      if (value == null) {
         value = parseDateTimeLiteral(getImage());
      }
      return value;
   }
}
