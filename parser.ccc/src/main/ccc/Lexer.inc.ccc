// DAX Lexer Grammar

SKIP : < WHITESPACE : (" " | "\t" | "\n" | "\r")+ > ;

TOKEN :
   < EVALUATE : "EVALUATE" >
;

// Keywords for the optional ORDER BY clause of an EvaluateStatement, e.g.
// EVALUATE 'Sales' ORDER BY 'Sales'[OrderDate] DESC. Declared as reserved
// tokens (like EVALUATE above), not as generic IDENTIFIERs, so
// EvaluateStatement can recognize the clause by token type alone. The
// trailing ASC/DESC direction is deliberately NOT a reserved token here: it
// stays a plain IDENTIFIER (see OrderByItem in Statements.inc.ccc), the same
// one already used for a bare Keyword value such as the DESC argument of
// TOPN(...) - reserving ASC/DESC too would break that unrelated usage.
TOKEN :
   < ORDER : "ORDER" >
   |
   < BY : "BY" >
;

// Keywords for the optional DEFINE clause of a DaxStatement, e.g.
// DEFINE MEASURE 'Sales'[Total Amount] = SUM('Sales'[Amount]) EVALUATE ...
// or DEFINE TABLE TopProducts = TOPN(...) EVALUATE ... or
// DEFINE COLUMN 'Sales'[Amount Category] = IF(...) EVALUATE ... or
// DEFINE VAR __minAmount = 1000 EVALUATE ... . Reserved tokens for the same
// reason as EVALUATE/ORDER/BY above.
TOKEN :
   < DEFINE : "DEFINE" >
   |
   < MEASURE : "MEASURE" >
   |
   < TABLE : "TABLE" >
   |
   < COLUMN : "COLUMN" >
   |
   < VAR : "VAR" >
;

// Boolean literals share the BooleanLiteral node class: each token
// occurrence becomes a BooleanLiteral node, distinguished at runtime by its
// own token type (TRUE vs. FALSE).
TOKEN #Literal :
   < TRUE : "true" > #BooleanLiteral
   |
   < FALSE : "false" > #BooleanLiteral
;

TOKEN #Delimiter :
   < LBRACE : "{" >
   |
   < RBRACE : "}" >
   |
   < LPAREN : "(" >
   |
   < RPAREN : ")" >
   |
   < COMMA : "," >
;

// Comparison operators for BooleanExpression. All seven alternatives share
// the ComparisonOperator node class (no per-alternative #override), so
// BooleanExpression can find the matched operator token via
// firstChildOfType(ComparisonOperator.class) and tell which one it was via
// getType(). Longer operators (<=, >=, <>) are matched over their shorter
// prefixes (<, >) by the lexer's usual maximal-munch rule, so declaration
// order here does not matter. IN is declared here (ahead of the generic
// IDENTIFIER token further below) so the word "IN" is always recognized as
// this reserved operator rather than as a generic identifier/Keyword value.
TOKEN #ComparisonOperator :
   < LESS_THAN_OR_EQUAL : "<=" >
   |
   < GREATER_THAN_OR_EQUAL : ">=" >
   |
   < NOT_EQUAL : "<>" >
   |
   < LESS_THAN : "<" >
   |
   < GREATER_THAN : ">" >
   |
   < EQUAL : "=" >
   |
   < IN : "IN" >
;

// Arithmetic operators for ArithmeticExpression. Named ArithmeticOperatorToken
// (not ArithmeticOperator) to avoid colliding with the model.api enum of the
// same simple name, org.eclipse.daanse.dax.model.api.expression
// .ArithmeticExpression.ArithmeticOperator, which ArithmeticExpression's
// INJECT block below also needs in scope.
TOKEN #ArithmeticOperatorToken :
   < PLUS : "+" >
   |
   < MINUS : "-" >
   |
   < ASTERISK : "*" >
   |
   < SLASH : "/" >
   |
   < CARET : "^" >
;

// Logical operators for LogicalExpression. DAX spells AND/OR as && and ||,
// not the keywords. Named LogicalOperatorToken (not LogicalOperator) for the
// same reason as ArithmeticOperatorToken above: it must not collide with the
// model.api enum of the same simple name that LogicalExpression's INJECT
// block below also needs in scope.
TOKEN #LogicalOperatorToken :
   < AND : "&&" >
   |
   < OR : "||" >
;

// The string operator for StringExpression. DAX has a single string
// operator, & (concatenation). Named StringOperatorToken (not
// StringOperator) for the same reason as ArithmeticOperatorToken/
// LogicalOperatorToken above: it must not collide with the model.api enum
// of the same simple name that StringExpression's INJECT block below also
// needs in scope.
TOKEN #StringOperatorToken :
   < AMPERSAND : "&" >
;

// A DAX string literal: double-quoted, where an embedded double quote is
// escaped by doubling it, e.g. "He said ""hi""".
TOKEN :
   < #DOUBLED_QUOTE : "\"\"" >
   |
   < STRING_LITERAL : "\"" ( <DOUBLED_QUOTE> | ~["\""] )* "\"" > #StringLiteral
;

// A DAX date/time literal, e.g. dt"2024-01-31T10:30:00" or the date-only
// dt"2024-01-31". No embedded-quote escaping: date/time values never
// contain a double quote.
TOKEN :
   < DATE_TIME_LITERAL : "dt" "\"" (~["\""])* "\"" > #DateTimeLiteral
;

// A DAX entity (table) name, single-quoted, e.g. 'Sales'; an embedded single
// quote is escaped by doubling it, e.g. 'It''s Sales'. Quoting is required
// only when the name contains spaces or special characters, but this grammar
// currently only recognizes the quoted form.
TOKEN :
   < #DOUBLED_SINGLE_QUOTE : "''" >
   |
   < ENTITY_NAME : "'" ( <DOUBLED_SINGLE_QUOTE> | ~["'"] )* "'" > #Entity
;

// A DAX numeric literal, e.g. 42 or 3.14. No leading sign and no exponent
// notation yet; those belong to unary/binary expression grammar once it
// exists.
TOKEN :
   < #DIGIT : ["0"-"9"] >
   |
   < NUMERIC_LITERAL : (<DIGIT>)+ ("." (<DIGIT>)+)? > #NumericLiteral
;

// An unquoted identifier, currently used only as a DAX function name, e.g.
// NOW or ALL. Declared after EVALUATE/TRUE/FALSE above: on an equal-length
// match, congocc's lexer prefers whichever token was declared first, so
// those keywords are still matched as themselves rather than as a generic
// identifier. Tagged #FunctionName (not #Identifier) so the node class does
// not collide with the public Identifier node below, which represents a
// fully qualified column reference such as 'Sales'[Status], not a bare
// function name.
TOKEN :
   < IDENTIFIER : ["a"-"z","A"-"Z","_"] (["a"-"z","A"-"Z","0"-"9","_"])* > #FunctionName
;

// A DAX scalar (column) reference in square brackets, e.g. [Status]. No
// embedded-bracket escaping: column names never contain "]" in this
// grammar. Always paired with a preceding entity (table) reference to form
// an Identifier - see EntityReference below.
TOKEN :
   < COLUMN_REFERENCE : "[" (~["]"])* "]" > #Scalar
;

INJECT PARSER_CLASS :
{
   /**
    * Strips the surrounding double quotes from a DAX
    * {@link #STRING_LITERAL} token image and un-doubles embedded
    * {@code ""} escapes back into a single {@code "}.
    */
   public static String stripQuotes(String image) {
      String inner = image.substring(1, image.length() - 1);
      return inner.replace("\"\"", "\"");
   }

   /**
    * Strips the surrounding single quotes from a DAX {@link #ENTITY_NAME}
    * token image and un-doubles embedded {@code ''} escapes back into a
    * single {@code '}.
    */
   public static String stripSingleQuotes(String image) {
      String inner = image.substring(1, image.length() - 1);
      return inner.replace("''", "'");
   }

   /**
    * Strips the surrounding square brackets from a DAX
    * {@link #COLUMN_REFERENCE} token image, e.g. {@code [Status]} to
    * {@code Status}.
    */
   public static String stripBrackets(String image) {
      return image.substring(1, image.length() - 1);
   }

   /**
    * Parses a {@link #DATE_TIME_LITERAL} token image (the {@code dt"..."}
    * form) into a {@link java.time.LocalDateTime}, defaulting to midnight
    * when only a date is given.
    */
   public static java.time.LocalDateTime parseDateTimeLiteral(String image) {
      String inner = image.substring(3, image.length() - 1);
      if (inner.indexOf('T') >= 0) {
         return java.time.LocalDateTime.parse(inner);
      }
      return java.time.LocalDate.parse(inner).atStartOfDay();
   }
}

INJECT StringLiteral :
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.stripQuotes;
   implements org.eclipse.daanse.dax.model.api.expression.StringLiteral
{
   private String value;

   public String value() {
      if (value == null) {
         value = stripQuotes(getImage());
      }
      return value;
   }
}

INJECT BooleanLiteral :
   implements org.eclipse.daanse.dax.model.api.expression.BooleanLiteral
{
   public boolean value() {
      return getType() == TokenType.TRUE;
   }
}

INJECT NumericLiteral :
   import java.math.BigDecimal;
   implements org.eclipse.daanse.dax.model.api.expression.NumericLiteral
{
   private BigDecimal value;

   public BigDecimal value() {
      if (value == null) {
         value = new BigDecimal(getImage());
      }
      return value;
   }
}

INJECT Entity :
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.stripSingleQuotes;
   implements org.eclipse.daanse.dax.model.api.expression.Entity
{
   private String name;

   public String name() {
      if (name == null) {
         name = stripSingleQuotes(getImage());
      }
      return name;
   }
}

INJECT Identifier :
   implements org.eclipse.daanse.dax.model.api.expression.Identifier
{
   public java.util.List<org.eclipse.daanse.dax.model.api.expression.DaxExpression> parts() {
      return childrenOfType(org.eclipse.daanse.dax.model.api.expression.DaxExpression.class);
   }
}

INJECT Scalar :
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.stripBrackets;
   implements org.eclipse.daanse.dax.model.api.expression.Scalar
{
   private String name;

   public String name() {
      if (name == null) {
         name = stripBrackets(getImage());
      }
      return name;
   }
}

INJECT DateTimeLiteral :
   import java.time.LocalDateTime;
   import static org.eclipse.daanse.dax.parser.ccc.DaxParser.parseDateTimeLiteral;
   implements org.eclipse.daanse.dax.model.api.expression.DateTimeLiteral
{
   private LocalDateTime value;

   public LocalDateTime value() {
      if (value == null) {
         value = parseDateTimeLiteral(getImage());
      }
      return value;
   }
}
