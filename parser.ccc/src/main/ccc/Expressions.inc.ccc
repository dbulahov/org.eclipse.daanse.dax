// DAX Expression Grammar

INJECT TableConstructor :
   implements org.eclipse.daanse.dax.model.api.expression.TableConstructor
{
   public java.util.List<org.eclipse.daanse.dax.model.api.expression.RowConstructor> rows() {
      return childrenOfType(org.eclipse.daanse.dax.model.api.expression.RowConstructor.class);
   }
}

// #TableConstructor forces a definite node even for a single-row table,
// e.g. {"Hello World"}, so it does not collapse to its only RowConstructor
// child.
TableConstructor#TableConstructor :
   < LBRACE >
   RowConstructor ( < COMMA > RowConstructor )*
   < RBRACE >
;

INJECT RowConstructor :
   implements org.eclipse.daanse.dax.model.api.expression.RowConstructor
{
   public java.util.List<org.eclipse.daanse.dax.model.api.expression.DaxExpression> columns() {
      return childrenOfType(org.eclipse.daanse.dax.model.api.expression.DaxExpression.class);
   }
}

// A row constructor is normally parenthesized, e.g. ("Value1", 1, TRUE);
// DAX allows the parentheses to be omitted for a single-column row, e.g.
// the bare "Hello World" in {"Hello World"}. #RowConstructor forces a
// definite node in that single-column case too, so it does not collapse to
// its only column expression.
RowConstructor#RowConstructor :
   < LPAREN > Expression ( < COMMA > Expression )* < RPAREN >
   |
   Expression
;

// Void: a primary expression is always represented by whichever concrete
// node matched; no separate wrapper node is created.
PrimaryExpression#void :
   TableConstructor
   |
   < STRING_LITERAL >
   |
   < NUMERIC_LITERAL >
   |
   < TRUE >
   |
   < FALSE >
   |
   < DATE_TIME_LITERAL >
;

INJECT BooleanExpression :
   import org.eclipse.daanse.dax.model.api.expression.BooleanExpression.BooleanOperator;
   implements org.eclipse.daanse.dax.model.api.expression.BooleanExpression
{
   public org.eclipse.daanse.dax.model.api.expression.DaxExpression left() {
      return childrenOfType(org.eclipse.daanse.dax.model.api.expression.DaxExpression.class).get(0);
   }

   public BooleanOperator operator() {
      ComparisonOperator op = firstChildOfType(ComparisonOperator.class);
      return switch (op.getType()) {
         case LESS_THAN -> BooleanOperator.LESS_THAN;
         case LESS_THAN_OR_EQUAL -> BooleanOperator.LESS_THAN_OR_EQUAL;
         case GREATER_THAN -> BooleanOperator.GREATER_THAN;
         case GREATER_THAN_OR_EQUAL -> BooleanOperator.GREATER_THAN_OR_EQUAL;
         case EQUAL -> BooleanOperator.EQUAL;
         case NOT_EQUAL -> BooleanOperator.NOT_EQUAL;
         default -> throw new IllegalStateException("Unexpected comparison operator: " + op.getType());
      };
   }

   public org.eclipse.daanse.dax.model.api.expression.DaxExpression right() {
      return childrenOfType(org.eclipse.daanse.dax.model.api.expression.DaxExpression.class).get(1);
   }
}

// No #void and no forced #BooleanExpression: SMART_NODE_CREATION collapses
// this to its single PrimaryExpression child when there is no comparison
// operator, and only builds a real BooleanExpression node (left, operator
// token, right) when one is present.
BooleanExpression :
   PrimaryExpression
   [
      ( < LESS_THAN > | < LESS_THAN_OR_EQUAL > | < GREATER_THAN > | < GREATER_THAN_OR_EQUAL > | < EQUAL > | < NOT_EQUAL > )
      PrimaryExpression
   ]
;

// Void: currently a thin alias for BooleanExpression, kept as the stable
// entry point that EvaluateStatement/RowConstructor/ExpressionRoot call, so
// future precedence levels (logical AND/OR, ...) can be inserted here
// without touching those call sites.
Expression#void :
   BooleanExpression
;

// Entry point for DaxParser#parseExpression(): parses one expression and
// requires the whole input to be consumed, so trailing garbage is a syntax
// error.
ExpressionRoot#void :
   Expression < EOF >
;
